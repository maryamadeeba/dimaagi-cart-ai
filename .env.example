# Dimaagi Cart settings for the CLI tools and personal mode. Copy this file to .env and fill in your own key.
# Never commit .env.

# Your Gemini API key from Google AI Studio (required for generation, chat and judging)
GEMINI_API_KEY=your-key-here

# Model for "why" summaries and campaign kits (model names change: list yours with client.models.list())
GEMINI_MODEL=gemini-3.8-flash

# Model for the faithfulness judge (eval.judge). JUDGE_MODEL is also used by eval/build_labels.py; the published
# labels were made and human-validated with Flash-Lite. Changing it changes how strict "relevant" is, so re-run
# the human spot-check if you change it.
JUDGE_MODEL=gemini-3.5-flash-lite

# Model for the assistant chat
CHAT_MODEL=gemini-3.5-flash-lite

# Retrieval for batch generation: vector, bm25, hybrid or hybrid_rerank (best quality, ~1.7s per query)
RETRIEVAL_METHOD=hybrid_rerank

# Retrieval for the chat: hybrid is fast (~0.12s per query)
CHAT_RETRIEVAL=hybrid
